# Next.js env vars

# Canonical site origin used for canonical URLs + metadata base
NEXT_PUBLIC_SITE_ORIGIN=https://www.donnacrm.com

# Google Analytics 4 Measurement ID (optional)
# Example: G-J6SFW71F99
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads (Google tag) (optional)
# Tag ID example: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=

# Optional: track "Install CTA click" as a Google Ads conversion event.
# This is the exact `send_to` value from Google Ads' event snippet.
# Example: AW-123456789/AbCdEfGhIjkLmNoPq
NEXT_PUBLIC_GOOGLE_ADS_INSTALL_SEND_TO=
